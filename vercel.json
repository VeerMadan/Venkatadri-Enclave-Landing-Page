{
  "framework": "vite",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/admin-portal/(.*)", "destination": "/admin-portal/index.html" },
    { "source": "/admin-portal", "destination": "/admin-portal/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
